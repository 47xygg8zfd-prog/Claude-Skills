# Word Digest — Environment Configuration
# Copy this file to word-digest/config.env and fill in your values.
# NEVER commit config.env — it contains your email password.

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── SMTP ─────────────────────────────────────────────────────────────────────
# Gmail defaults shown. See README for other providers (Outlook, iCloud, etc.)
WORD_DIGEST_SMTP_HOST=smtp.gmail.com
WORD_DIGEST_SMTP_PORT=587

# ── Sender credentials ────────────────────────────────────────────────────────
# For Gmail: use an App Password, NOT your Google account password.
# Your regular password will not work — Gmail blocks it for SMTP access.
# Generate one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on your account.
WORD_DIGEST_EMAIL_FROM=you@gmail.com
WORD_DIGEST_EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Recipients ────────────────────────────────────────────────────────────────
# Comma-separated for multiple recipients.
WORD_DIGEST_EMAIL_TO=recipient@example.com
# WORD_DIGEST_EMAIL_TO=person1@example.com,person2@example.com
